# SmartEye behind Authelia: HTTPS, private LAN only, every page needs a login.
# Same forward-auth shape as the musicdedup/orcaslicer/libation proxies.

# Authelia's cookie is for ${SMARTEYE_HOSTNAME} only: send any other name or bare IP there.
server {
    listen 3001 ssl default_server;
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    return 301 https://${SMARTEYE_HOSTNAME}:3001$request_uri;
}

server {
    listen 3001 ssl;
    http2 on;
    server_name ${SMARTEYE_HOSTNAME};

    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;

    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny  all;

    # Names resolved per request through Docker's DNS: with literal names nginx resolves at
    # start-up and fails if a container isn't up yet.
    resolver 127.0.0.11 valid=30s;
    set $authelia http://authelia:9091;
    set $smarteye http://smarteye:8090;

    # $http_host, not $host: the port is non-standard and $host drops it, which makes
    # Authelia build redirects to :443.
    auth_request /internal/authelia/authz;
    auth_request_set $redirection_url $upstream_http_location;
    auth_request_set $user $upstream_http_remote_user;
    error_page 401 =302 $redirection_url;

    location /internal/authelia/authz {
        internal;
        auth_request off;
        proxy_pass $authelia/authelia/api/authz/auth-request;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_http_version 1.1;
    }

    location /authelia {
        auth_request off;
        proxy_pass $authelia$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass $smarteye;
        proxy_set_header Host $http_host;
        # Always overwritten, so a browser can never supply its own Remote-User.
        proxy_set_header Remote-User $user;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        # Face crops and frames run to a few hundred KB: hold them in memory, not temp files.
        proxy_buffer_size 16k;
        proxy_buffers 32 32k;
        proxy_busy_buffers_size 64k;
    }
}
