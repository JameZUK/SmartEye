# Copy to .env and fill in. .env is git-ignored: it holds tokens and passwords.

# Login for the web UI and API (strongly recommended: the UI shows faces). One of:
#   basic     HTTP basic auth with SMARTEYE_AUTH=user:password
#   authelia  Authelia login page via the bundled proxy (README "Login with Authelia"):
#             also set COMPOSE_PROFILES=authelia, SMARTEYE_HOSTNAME and SMARTEYE_TRUSTED_PROXIES
#   none      open (empty mode and empty SMARTEYE_AUTH)
SMARTEYE_AUTH_MODE=
SMARTEYE_AUTH=
# authelia mode: the proxy's fixed address (= SMARTEYE_PROXY_IP, default 172.25.0.10)
SMARTEYE_TRUSTED_PROXIES=
# COMPOSE_PROFILES=authelia
# SMARTEYE_HOSTNAME=smarteye.example.lan
# SMARTEYE_LOGIN_PORT=3001
# ImmichEye sends this as a Bearer token (IMMICHEYE_EVENTS_TOKEN). Generate: openssl rand -hex 24
SMARTEYE_INGEST_TOKEN=
# Where the web UI listens
SMARTEYE_BIND=0.0.0.0
SMARTEYE_PORT=8090
# Base URL Home Assistant uses to fetch face images in notifications (signed links; no password needed)
SMARTEYE_PUBLIC_URL=http://smarteye.example.lan:8090
# Local time zone for "today", heatmaps and usual times
SMARTEYE_TZ=Europe/London

# Cameras that build the visitor database when first seen (Blue Iris short names).
# Others are listed in Settings, where any camera can be switched on or off.
SMARTEYE_CAMERAS=FDoor,BDoor
# Must match ImmichEye's IMMICHEYE_MODEL
SMARTEYE_MODEL=buffalo_l

# Quality gate: smaller or less certain faces count towards visits but never create or match identities
SMARTEYE_MIN_FACE_PX=40
SMARTEYE_MIN_DET=0.75
# A visit ends this many seconds after the person's last face; faces this similar join an open visit
SMARTEYE_VISIT_GAP_S=120
SMARTEYE_VISIT_LINK=0.30
# Identity matching (cosine; ImmichEye's scale). Pairs above SUGGEST are offered on the Review page.
SMARTEYE_MATCH_THRESHOLD=0.45
SMARTEYE_MATCH_MARGIN=0.05
SMARTEYE_TOP_K=3
SMARTEYE_REF_FACES=30
SMARTEYE_SUGGEST_THRESHOLD=0.33
# Forget visits older than this many days (0 = keep forever)
SMARTEYE_RETENTION_DAYS=365

# Home Assistant over MQTT: mqtt://user:password@host:1883 (mqtts:// for TLS). Empty = off.
SMARTEYE_MQTT_URL=
SMARTEYE_MQTT_PREFIX=smarteye
SMARTEYE_HA_DISCOVERY=homeassistant
# Friendly door names for Home Assistant entities and announcements
SMARTEYE_CAMERA_LABELS=FDoor:Front door,BDoor:Back door
# Home Assistant reports doorbell presses to /api/doorbell with this Bearer token. Empty = off.
SMARTEYE_DOORBELL_TOKEN=
SMARTEYE_RING_WINDOW_S=30
